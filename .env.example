# Copy to .env for local development. Never commit .env or share its contents.
OPENROUTER_API_KEY=
# Use a model ID available to your OpenRouter account.
OPENROUTER_MODEL=

# Optional API bearer authentication. Strongly recommended outside local development.
# Generate a long random value and configure clients to send Authorization: Bearer <value>.
COGNIS_API_KEY=

# Evaluation resource bounds
COGNIS_MAX_CASES_PER_REQUEST=50
COGNIS_MAX_INPUT_CHARS=12000
COGNIS_MAX_TIMEOUT_SECONDS=60
